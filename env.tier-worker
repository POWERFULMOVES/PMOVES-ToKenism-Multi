# PMOVES.AI Tier Environment: Worker Services
# For extract-worker, langextract, pdf-ingest, notebook-sync
# Principle: Data tier access + TensorZero for embeddings, NO external API keys
#
# Usage: Source after env.shared or use as Docker env_file
#   source env.shared && source env.tier-worker
#   OR: env_file: [env.docker, env.tier-worker] in docker-compose.yml
#
# Example docker-compose.yml:
#   services:
#     extract-worker:
#       env_file:
#         - env.docker
#         - env.tier-worker
#
# Place at: env.tier-worker in your submodule root

# ============================================================================
# Tier Identifier
# ============================================================================

TIER=worker

# ============================================================================
# NATS (Event Bus)
# ============================================================================

NATS_URL=nats://nats:4222
NATS_JETSTREAM=true

# ============================================================================
# TensorZero (for embeddings via internal gateway)
# ============================================================================

TENSORZERO_BASE_URL=http://tensorzero-gateway:3030
TENSORZERO_URL=http://tensorzero-gateway:3030
TENSORZERO_EMBED_MODEL=tensorzero::embedding_model_name::qwen3_embedding_4b_local
TENSORZERO_EMBED_BATCH_SIZE=16
TENSORZERO_EMBED_TIMEOUT_SECS=120

# ============================================================================
# Qdrant (Vector Store)
# ============================================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pmoves_chunks_qwen3
SENTENCE_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Meilisearch (Full-Text Indexing)
# ============================================================================

MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=${MEILISEARCH_API_KEY}

# ============================================================================
# MinIO (Object Storage for Documents)
# SECURITY WARNING: Change default credentials in production!
#   Default minioadmin/minioadmin is for development only.
#   Set MINIO_ACCESS_KEY and MINIO_SECRET_KEY in env.shared for production.
# ============================================================================

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-minioadmin}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-minioadmin}
MINIO_SECURE=false
MINIO_BUCKET=documents
MINIO_OUTPUT_BUCKET=processed

# ============================================================================
# Supabase (Metadata Storage)
# ============================================================================

SUPA_REST_URL=http://supabase_kong_PMOVES.AI:8000/rest/v1
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_KEY}

# ============================================================================
# Open Notebook (for notebook-sync)
# ============================================================================

OPEN_NOTEBOOK_API_URL=http://cataclysm-open-notebook:5055
OPEN_NOTEBOOK_API_TOKEN=${OPEN_NOTEBOOK_API_TOKEN}

# ============================================================================
# Indexer Defaults
# ============================================================================

INDEXER_NAMESPACE=pmoves

# ============================================================================
# Extract Worker Configuration
# ============================================================================

EXTRACT_WORKER_HOST_PORT=8083
EXTRACT_WORKER_EMBEDDING_BACKEND=tensorzero
EXTRACT_WORKER_BATCH_SIZE=100
EXTRACT_WORKER_MAX_RETRIES=3

# ============================================================================
# LangExtract Configuration
# ============================================================================

LANGEXTRACT_PROVIDER=rule
LANGEXTRACT_MODEL=ollama:gemma3

# ============================================================================
# PDF Processing
# ============================================================================

DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=4
PDF_OCR_ENABLED=true
PDF_FINANCIAL_ANALYSIS=true
FAST_PDF_MODE=false

# ============================================================================
# Worker Concurrency
# ============================================================================

WORKER_CONCURRENCY=4
WORKER_MAX_TASKS=1000
WORKER_IDLE_TIMEOUT_MS=60000
