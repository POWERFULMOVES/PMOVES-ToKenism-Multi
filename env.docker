# PMOVES.AI Docker Environment Configuration
# Docker-compatible format (no 'export' prefix)
#
# Usage: Reference in docker-compose.yml as env_file
#
# Note: For shell usage, source env.shared instead

# ============================================================================
# PMOVES.AI Environment Configuration
# ============================================================================

PMOVES_ENV=production
TIER=api

# Service identity (override in service-specific env files)
SERVICE_NAME=your-service-name
SERVICE_SLUG=your-service-slug

# ============================================================================
# Service Discovery (NATS)
# ============================================================================

NATS_URL=nats://nats:4222
NATS_JETSTREAM=true
NATS_SUBJECT_PREFIX=pmoves

# ============================================================================
# LLM Gateway (TensorZero)
# ============================================================================

TENSORZERO_URL=http://tensorzero-gateway:3030
TENSORZERO_CLICKHOUSE_URL=http://tensorzero-clickhouse:8123

# ============================================================================
# GPU Orchestrator
# ============================================================================

GPU_ORCHESTRATOR_URL=http://gpu-orchestrator:8050

# ============================================================================
# Data Services
# ============================================================================

# Qdrant (Vector Database)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Neo4j (Graph Database)
# SECURITY: Empty defaults require explicit configuration
NEO4J_URL=http://neo4j:7474
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Meilisearch (Full-Text Search)
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=

# MinIO (Object Storage)
# SECURITY: Empty defaults require explicit configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ============================================================================
# Supabase (PostgREST + Database)
# ============================================================================

SUPABASE_URL=http://supabase_kong_PMOVES.AI:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# ============================================================================
# Monitoring & Observability
# ============================================================================

PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PUSHGATEWAY=http://prometheus:9091
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://loki:3100

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PORT=9090

LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# Agent Zero
# ============================================================================

AGENT_ZERO_URL=http://agent-zero:8080
AGENT_ZERO_MCP_URL=http://agent-zero:8080
AGENT_ZERO_MCP_PATH=/mcp/*

# ============================================================================
# Hi-RAG Gateway
# ============================================================================

HIRAG_V2_URL=http://hi-rag-gateway-v2:8086
HIRAG_V1_URL=http://hi-rag-gateway:8089

# ============================================================================
# Archon
# ============================================================================

ARCHON_URL=http://archon:8091

# ============================================================================
# Network Configuration
# ============================================================================

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.local,.internal

# ============================================================================
# Security
# ============================================================================

CHIT_ENVIRONMENT=production
CHIT_VAULT_ENDPOINT=http://chit-vault:8050

# ============================================================================
# Timeouts & Limits
# ============================================================================

DEFAULT_TIMEOUT=30
REQUEST_TIMEOUT=60
CONNECT_TIMEOUT=10
MAX_RETRIES=3

# ============================================================================
# Health Check Configuration
# ============================================================================

HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_PATH=/healthz
