# PMOVES.AI Tier Environment: API Gateway Services
# For PostgREST, Hi-RAG v2, TensorZero gateway routing, Presign
# Principle: Data tier access + TensorZero internal gateway, NO external API keys
#
# Usage: Source after env.shared or use as Docker env_file
#   source env.shared && source env.tier-api
#   OR: env_file: [env.docker, env.tier-api] in docker-compose.yml
#
# Example docker-compose.yml:
#   services:
#     hirag-v2:
#       env_file:
#         - env.docker
#         - env.tier-api
#
# Place at: env.tier-api in your submodule root

# ============================================================================
# Tier Identifier
# ============================================================================

TIER=api

# ============================================================================
# NATS (Event Bus)
# ============================================================================

NATS_URL=nats://nats:pmoves@nats:4222

# ============================================================================
# TensorZero (Internal Gateway - NOT the API keys)
# ============================================================================

TENSORZERO_BASE_URL=http://tensorzero-gateway:3030
TENSORZERO_URL=http://tensorzero-gateway:3030

# ============================================================================
# Qdrant (Vector Store)
# ============================================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pmoves_chunks_qwen3

# ============================================================================
# Meilisearch (Full-Text Search)
# ============================================================================

MEILISEARCH_URL=http://meilisearch:7700
# SECURITY: Must be set from env.shared or secrets (no default - will fail if unset)
MEILISEARCH_API_KEY=${MEILISEARCH_API_KEY}

# ============================================================================
# Neo4j (Graph Database)
# ============================================================================

NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
# SECURITY: Must be set from env.shared or secrets (no default - will fail if unset)
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# ============================================================================
# Hi-RAG Reranking Configuration
# ============================================================================

RERANK_ENABLE=true
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_MODEL_PATH=/models/qwen/Qwen3-Reranker-4B
RERANK_USE_FP16=true
RERANK_TOPN=50
RERANK_K=10
SENTENCE_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Supabase (PostgREST)
# ============================================================================

SUPA_REST_URL=http://supabase_kong_PMOVES.AI:8000/rest/v1
# SECURITY: SUPABASE_SERVICE_ROLE_KEY should be set from env.shared or secrets
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_KEY}

# ============================================================================
# Presign Service
# ============================================================================

PRESIGN_SHARED_SECRET=${PRESIGN_SHARED_SECRET}
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_SECURE=false

# ============================================================================
# API Rate Limiting
# ============================================================================

API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Health Check
# ============================================================================

HEALTH_CHECK_PATH=/healthz
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
