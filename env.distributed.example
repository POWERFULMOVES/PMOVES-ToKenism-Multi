# PMOVES-ToKenism-Multi Distributed Deployment Configuration
# Copy to .env.distributed and configure for your network topology
#
# This configuration enables Tokenism to run independently on separate hardware
# and connect to other PMOVES submodules via local network, Tailscale, or VPS.

# =============================================================================
# NETWORK MODE
# =============================================================================
# Deployment mode: standalone | docked | distributed
DEPLOYMENT_MODE=distributed

# When true, enables cross-host service discovery via environment variables
# instead of Docker DNS (container names like 'nats', 'tensorzero', etc.)
DISTRIBUTED_SERVICES=true

# =============================================================================
# SERVICE IDENTITY
# =============================================================================
SERVICE_NAME=pmoves-tokenism
SERVICE_SLUG=tokenism
PMOVES_ENV=production
TIER=worker

# =============================================================================
# THIS SERVICE (Tokenism Simulation Framework)
# =============================================================================
TOKENISM_HOST=localhost
TOKENISM_PORT=5000
TOKENISM_URL=http://${TOKENISM_HOST}:${TOKENISM_PORT}

# Flask backend settings
FLASK_ENV=production
FLASK_DEBUG=false

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================
# Replace Docker DNS names with actual hostnames/IPs for distributed deployment.
# Use one of:
#   - Local network IPs: 192.168.1.x
#   - Tailscale IPs: 100.x.y.z
#   - Tailscale hostnames: myhost.tailnet-name.ts.net
#   - VPS hostnames: vps.example.com

# NATS Message Bus (required for event coordination)
NATS_HOST=localhost
NATS_PORT=4222
NATS_URL=nats://${NATS_HOST}:${NATS_PORT}
NATS_JETSTREAM=true
NATS_SUBJECT_PREFIX=pmoves

# =============================================================================
# PARENT PMOVES.AI SERVICES
# =============================================================================
# Set these when connecting to parent PMOVES.AI infrastructure

# TensorZero LLM Gateway
TENSORZERO_HOST=localhost
TENSORZERO_PORT=3030
TENSORZERO_URL=http://${TENSORZERO_HOST}:${TENSORZERO_PORT}

# Supabase Database
SUPABASE_HOST=localhost
SUPABASE_PORT=54321
SUPABASE_URL=http://${SUPABASE_HOST}:${SUPABASE_PORT}

# Neo4j Knowledge Graph
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_URL=bolt://${NEO4J_HOST}:${NEO4J_PORT}

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# =============================================================================
# SIBLING SUBMODULE SERVICES
# =============================================================================
# Set these to connect to DoX and BoTZ on other hosts

# PMOVES-DoX Document Intelligence (Agent Zero lives here)
DOX_HOST=localhost
DOX_PORT=8484
DOX_BACKEND_URL=http://${DOX_HOST}:${DOX_PORT}

# Agent Zero (dual-instance in DoX)
AGENT_ZERO_HOST=${DOX_HOST}
AGENT_ZERO_HEADLESS_PORT=50051
AGENT_ZERO_UI_PORT=50052
AGENT_ZERO_URL=http://${AGENT_ZERO_HOST}:${AGENT_ZERO_HEADLESS_PORT}
AGENT_ZERO_MCP_URL=http://${AGENT_ZERO_HOST}:${AGENT_ZERO_HEADLESS_PORT}/mcp

# PMOVES-BoTZ MCP Gateway (Archon lives here)
BOTZ_HOST=localhost
BOTZ_GATEWAY_PORT=2091
BOTZ_GATEWAY_URL=http://${BOTZ_HOST}:${BOTZ_GATEWAY_PORT}

# Archon Knowledge + Agent Forge (in BoTZ)
ARCHON_HOST=${BOTZ_HOST}
ARCHON_PORT=8091
ARCHON_URL=http://${ARCHON_HOST}:${ARCHON_PORT}

# =============================================================================
# PMOVES-WEALTH INTEGRATION
# =============================================================================
# Firefly-iii financial simulation validation

WEALTH_HOST=localhost
WEALTH_PORT=8080
WEALTH_URL=http://${WEALTH_HOST}:${WEALTH_PORT}
FIREFLY_API_URL=http://${WEALTH_HOST}:${WEALTH_PORT}/api/v1
FIREFLY_TOKEN=your-firefly-personal-access-token

# =============================================================================
# CHIT GEOMETRY BUS
# =============================================================================
# Shape-attribution agent communication

CHIT_ENVIRONMENT=${PMOVES_ENV}
CHIT_VAULT_ENDPOINT=http://chit-vault:8050

# =============================================================================
# TAILSCALE INTEGRATION
# =============================================================================
# Enable Tailscale sidecar container for VPN mesh networking

TAILSCALE_ENABLED=false
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=pmoves-tokenism
# Advertise local Docker networks to Tailscale mesh
TAILSCALE_ADVERTISE_ROUTES=172.33.0.0/16

# Connect to parent Headscale control plane (optional)
# Leave blank for managed Tailscale cloud service
# Set to parent Headscale URL for self-hosted mesh
TAILSCALE_LOGIN_SERVER=${HEADSCALE_URL:-}
# Example: TAILSCALE_LOGIN_SERVER=https://headscale.pmoves.local:8096

# =============================================================================
# SECURITY (Required for distributed deployments)
# =============================================================================
# JWT secret for inter-service authentication
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Agent Zero MCP token for DoX integration
AGENT_ZERO_MCP_TOKEN=your-mcp-token-here

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PUSHGATEWAY=http://prometheus:9091
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# HARDWARE-SPECIFIC SETTINGS
# =============================================================================
# Tokenism typically runs CPU-only for simulation

DEFAULT_DEVICE=cpu
