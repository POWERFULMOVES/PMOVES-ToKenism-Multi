# PMOVES.AI Tier Environment: Data Storage Services
# For Postgres, Qdrant, Neo4j, Meilisearch, MinIO, NATS
# Principle: Infrastructure only - NO external API keys, NO external credentials
#
# Usage: Source after env.shared or use as Docker env_file
#   source env.shared && source env.tier-data
#   OR: env_file: [env.docker, env.tier-data] in docker-compose.yml
#
# Example docker-compose.yml:
#   services:
#     supabase-db:
#       env_file:
#         - env.docker
#         - env.tier-data
#
# Place at: env.tier-data in your submodule root

# ============================================================================
# Tier Identifier
# ============================================================================

TIER=data

# ============================================================================
# PostgreSQL
# ============================================================================

POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=pmoves
# SECURITY: POSTGRES_PASSWORD should be set from secrets
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# ============================================================================
# Qdrant (Vector Store)
# ============================================================================

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pmoves_chunks_qwen3
# Optional: Qdrant API key for production
QDRANT_API_KEY=${QDRANT_API_KEY}

# ============================================================================
# Neo4j (Graph Database)
# ============================================================================

NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
# SECURITY: Must be set from env.shared or secrets (no default - will fail if unset)
NEO4J_PASSWORD=${NEO4J_PASSWORD}
NEO4J_AUTH=neo4j/${NEO4J_PASSWORD}

# ============================================================================
# Meilisearch (Full-Text Search)
# ============================================================================

MEILISEARCH_URL=http://meilisearch:7700
# SECURITY: Must be set from env.shared or secrets (no default - will fail if unset)
MEILISEARCH_MASTER_KEY=${MEILISEARCH_API_KEY}

# ============================================================================
# MinIO (Object Storage)
# NOTE: These are LOCAL MinIO credentials, NOT external S3
# SECURITY WARNING: Change default credentials in production!
#   Default minioadmin/minioadmin is for development only.
#   Set MINIO_ACCESS_KEY and MINIO_SECRET_KEY in env.shared for production.
# ============================================================================

MINIO_ROOT_USER=${MINIO_ACCESS_KEY:?MINIO_ACCESS_KEY required}
MINIO_ROOT_PASSWORD=${MINIO_SECRET_KEY:?MINIO_SECRET_KEY required}
MINIO_REGION=${MINIO_REGION:-us-east-1}

# ============================================================================
# NATS (Message Queue)
# ============================================================================

NATS_URL=nats://nats:pmoves@nats:4222
NATS_JETSTREAM=true
NATS_SUBJECT_PREFIX=pmoves

# ============================================================================
# ClickHouse (Analytics)
# ============================================================================

CLICKHOUSE_URL=http://tensorzero-clickhouse:8123
CLICKHOUSE_USER=tensorzero
CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD:?CLICKHOUSE_PASSWORD required}
CLICKHOUSE_DB=tensorzero

# ============================================================================
# Redis (Caching - Optional)
# ============================================================================

REDIS_URL=redis://redis:6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================================
# Backup Configuration
# ============================================================================

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://pmoves-backups
