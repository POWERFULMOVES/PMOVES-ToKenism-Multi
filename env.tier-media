# PMOVES.AI Tier Environment: Media Services
# For pmoves-yt, ffmpeg-whisper, media-video, media-audio, ComfyUI
# Principle: MinIO for storage, NATS for events, Supabase for metadata
#
# Usage: Source after env.shared or use as Docker env_file
#   source env.shared && source env.tier-media
#   OR: env_file: [env.docker, env.tier-media] in docker-compose.yml
#
# Example docker-compose.yml:
#   services:
#     pmoves-yt:
#       env_file:
#         - env.docker
#         - env.tier-media
#
# Place at: env.tier-media in your submodule root

# ============================================================================
# Tier Identifier
# ============================================================================

TIER=media

# ============================================================================
# NATS (Event Bus)
# ============================================================================

NATS_URL=nats://nats:pmoves@nats:4222
NATS_JETSTREAM=true

# ============================================================================
# MinIO (Media Storage)
# SECURITY WARNING: Change default credentials in production!
#   Default minioadmin/minioadmin is for development only.
#   Set MINIO_ACCESS_KEY and MINIO_SECRET_KEY in env.shared for production.
# ============================================================================

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:?MINIO_ACCESS_KEY required}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY:?MINIO_SECRET_KEY required}
MINIO_SECURE=false
MINIO_BUCKET=assets
MINIO_OUTPUT_BUCKET=outputs

# ============================================================================
# Supabase (Metadata)
# ============================================================================

SUPA_REST_URL=http://supabase_kong_PMOVES.AI:8000/rest/v1
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_KEY}

# ============================================================================
# PMOVES.YT
# ============================================================================

YT_CHANNEL_CHECK_INTERVAL=3600
YT_INGEST_URL=http://pmoves-yt:8077/yt/ingest
YT_CONCURRENCY=2
YT_RATE_LIMIT=0.0
YT_ARCHIVE_DIR=/data/yt-dlp
YT_ENABLE_DOWNLOAD_ARCHIVE=true
YT_SUBTITLE_LANGS=en
YT_SUBTITLE_AUTO=false
YT_WRITE_INFO_JSON=true
YT_UPSERT_BATCH_SIZE=200
YT_ASYNC_UPSERT_ENABLED=true
YT_ENABLE_PO_TOKEN=true

# ============================================================================
# FFmpeg-Whisper (Transcription)
# ============================================================================

WHISPER_URL=http://ffmpeg-whisper:8078
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
YT_TRANSCRIPT_PROVIDER=faster-whisper
YT_WHISPER_MODEL=small
YT_TRANSCRIPT_DIARIZE=false

# ============================================================================
# Media Analysis (YOLO)
# ============================================================================

YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.25
FRAME_SAMPLE_RATE=5

# ============================================================================
# Voice Services (VibeVoice, TTS)
# ============================================================================

VIBEVOICE_URL=http://vibevoice:3000
VIBEVOICE_HOST_PORT=3000
VIBEVOICE_MODEL_ID=microsoft/VibeVoice-Realtime-0.5B
VIBEVOICE_DEVICE=auto
DEFAULT_VOICE_PROVIDER=vibevoice

# ============================================================================
# ComfyUI (Image Generation)
# ============================================================================

COMFYUI_HOST_PORT=8188
COMFYUI_URL=http://comfyui:8188

# ============================================================================
# TTS Studio
# ============================================================================

ULTIMATE_TTS_STUDIO_HOST_PORT=7861

# ============================================================================
# Indexer Namespace
# ============================================================================

INDEXER_NAMESPACE=pmoves

# ============================================================================
# Media Processing Limits
# ============================================================================

MAX_VIDEO_DURATION_SECONDS=7200
MAX_AUDIO_DURATION_SECONDS=14400
MAX_FILE_SIZE_MB=2048
